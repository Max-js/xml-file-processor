{
  "name": "xml-file-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "orders": "./app/main.ts"
  },
  "scripts": {
    "init-db": "node --env-file=.env app/main.ts init-db",
    "import": "node --env-file=.env app/main.ts import",
    "list": "node --env-file=.env app/main.ts list",
    "show": "node --env-file=.env app/main.ts show",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.9.3"
  }
}
